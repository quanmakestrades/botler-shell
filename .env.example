# Botler Finance Dashboard — Environment Variables
# Copy to .env.local and fill in your values. NEVER commit .env.local to git.

# Plaid (read-only — balance + transactions scopes only)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox  # sandbox | development | production

# Coinbase (read-only — wallet:accounts:read + wallet:transactions:read only, no trading permissions)
COINBASE_API_KEY=
COINBASE_API_SECRET=

# Solana
SOLANA_WALLET_ADDRESS=
HELIUS_API_KEY=  # Optional. Falls back to public Solana RPC if empty.

# f100rd.com analytics
F100RD_WEBHOOK_SECRET=  # Used to verify HMAC-SHA256 webhook signatures
F100RD_API_KEY=

# Auth
BOTLER_FINANCE_PIN=1234  # Replace with real PIN. Move to secrets vault before any non-local deployment.

# General
NODE_ENV=development
